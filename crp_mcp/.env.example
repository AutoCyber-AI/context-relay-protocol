# Mode: local | hosted
CRP_MCP_MODE=hosted

# Clerk auth (required in hosted mode)
CLERK_ISSUER=https://...
CLERK_AUTHORIZED_PARTIES=https://...,https://...
CLERK_SECRET_KEY=<YOUR_CLERK_SECRET_KEY>

# Role & permissions
CRP_MCP_ROLE=user
CRP_MCP_TOOLS_ALLOW=
CRP_MCP_TOOLS_DENY=

# CRP backends
CRP_GATEWAY_URL=https://gateway.crprotocol.io/v1
CRP_COMPLY_BASE_URL=https://comply.crprotocol.io
CRP_SCAN_BASE_URL=https://scan.crprotocol.io
CRP_HOSTED_API_KEY=
CRP_PUBLIC_ORIGIN=https://crprotocol.io

# Stripe
STRIPE_SECRET_KEY=<YOUR_STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<YOUR_STRIPE_WEBHOOK_SECRET>
STRIPE_GATEWAY_DEVELOPER_PRICE_ID=<YOUR_STRIPE_PRICE_ID>
STRIPE_GATEWAY_TEAM_PRICE_ID=<YOUR_STRIPE_PRICE_ID>
STRIPE_COMPLY_STARTER_PRICE_ID=<YOUR_STRIPE_PRICE_ID>
STRIPE_COMPLY_SCALE_PRICE_ID=<YOUR_STRIPE_PRICE_ID>
STRIPE_SCAN_STARTER_PRICE_ID=<YOUR_STRIPE_PRICE_ID>
STRIPE_SCAN_SCALE_PRICE_ID=<YOUR_STRIPE_PRICE_ID>

# Audit & checkpoints
CRP_MCP_AUDIT_LOG=/var/log/crp_mcp_audit.jsonl
CRP_MCP_CHECKPOINT_LOG=/var/log/crp_mcp_checkpoints.jsonl
CRP_MCP_AUDIT_HMAC_SECRET=change-me-in-production

# Optional centralized audit endpoint (e.g. CRP Comply audit sink).
# When set, every audit record is also forwarded fire-and-forget to this URL.
CRP_AUDIT_ENDPOINT=https://comply.crprotocol.io/v1/audit
CRP_AUDIT_API_KEY=
CRP_MCP_CHECKPOINT_CONNECTORS=console,comply,slack,gmail,fcm
CRP_MCP_CHECKPOINT_WEBHOOK_URL=

# Optional escalation policy (JSON array). After 15 min escalate to Slack; after 1h auto-reject.
CRP_MCP_CHECKPOINT_ESCALATION=[{"after_seconds":900,"channels":["slack"]},{"after_seconds":3600,"on_timeout":"reject"}]

# Optional routing rules for checkpoint_when (JSON array).
CRP_MCP_CHECKPOINT_ROUTES=[{"condition":"risk >= HIGH","connector":"slack","route_to":"#safety"},{"condition":"tool_call == 'deploy_endpoint'","connector":"pagerduty","route_to":""}]

# Review-channel connectors
SLACK_WEBHOOK_URL=

# Gmail (App Password, NOT your regular Gmail password)
GMAIL_USER=alerts@crprotocol.io
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_TO=team@crprotocol.io,ops@crprotocol.io

# Generic SMTP fallback (only needed if not using Gmail)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Firebase Cloud Messaging (FCM)
# Paste the full service-account JSON here, or point to a file via GOOGLE_APPLICATION_CREDENTIALS
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
FIREBASE_PROJECT_ID=
FCM_DEVICE_TOKENS=token1,token2

# PagerDuty (optional, only if you enable "pagerduty")
PAGERDUTY_ROUTING_KEY=

# Twilio SMS (optional, only if you enable "sms")
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_TO=

# NEVER enable in production
CRP_MCP_HOSTED_BYPASS_AUTH=false
