{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilityDescriptor",
  "description": "Machine-readable declaration of a callable capability in the CRP Tool Capability Fabric (CRP-SPEC-050).",
  "type": "object",
  "required": [
    "capability_id",
    "kind",
    "version",
    "operation_types",
    "input_schema",
    "output_schema",
    "produces_facts",
    "cost_profile"
  ],
  "properties": {
    "capability_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Stable identifier for the capability."
    },
    "kind": {
      "type": "string",
      "enum": ["tool", "mcp-tool", "agent", "query", "service"],
      "description": "Runtime kind of the capability."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "SemVer version of the descriptor."
    },
    "operation_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["RETRIEVE", "ANALYSE", "COMPARE", "SYNTHESISE", "GENERATE", "VERIFY", "TRANSFORM", "PLAN", "CLARIFY", "REVISE"]
      },
      "description": "Canonical STL operation types this capability serves (CRP-SPEC-031 / CRP v5 taxonomy)."
    },
    "serves_intents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "description": "Intent tokens used for coarse retrieval filtering."
    },
    "input_schema": {
      "$ref": "https://json-schema.org/draft/2020-12/schema",
      "description": "JSON Schema describing valid arguments for this capability."
    },
    "output_schema": {
      "$ref": "https://json-schema.org/draft/2020-12/schema",
      "description": "JSON Schema describing the structure returned by this capability."
    },
    "produces_facts": {
      "type": "boolean",
      "description": "Whether the output should be stored as typed facts in the CSO."
    },
    "consumes_facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "description": "Fact categories the capability may read."
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "description": "Capability IDs that must execute before this capability."
    },
    "mutually_exclusive_with": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "description": "Capability IDs that MUST NOT be offered together with this one."
    },
    "cost_profile": {
      "type": "object",
      "required": ["tokens", "latency_ms", "safety_class"],
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Estimated token consumption of the capability."
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Estimated latency in milliseconds."
        },
        "safety_class": {
          "type": "string",
          "enum": ["read-only", "mutating", "destructive", "network", "human-oversight"],
          "description": "Safety classification used for policy filtering."
        }
      },
      "additionalProperties": false
    },
    "data_residency": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "description": "Jurisdiction constraint (e.g. EU, US, AU)."
    },
    "allowed_policy_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "description": "Policy domains under which this capability is permitted."
    },
    "embedding_vector": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Dense vector for semantic retrieval."
    },
    "embedding_model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Identifier of the model used to produce embedding_vector."
    },
    "metadata": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "description": "Human-readable metadata and provider tags."
    }
  },
  "additionalProperties": false
}
